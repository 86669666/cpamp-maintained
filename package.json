{
  "name": "cpa-manager-plus",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/docs"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:demo": "bun run --cwd apps/web dev:demo",
    "build": "bun run --cwd apps/web build",
    "build:demo": "bun run --cwd apps/web build:demo",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:preview": "bun run --cwd apps/docs preview",
    "check:demo-isolation": "bun bin/release/check-web-demo-isolation.mjs",
    "preview": "bun run --cwd apps/web preview",
    "preview:demo": "bun run --cwd apps/web preview:demo",
    "release:validate": "bun bin/release/validate-release.mjs",
    "test": "vitest run --root . --config apps/web/vite.config.ts apps/web/src tests",
    "lint": "bun run --cwd apps/web lint",
    "format": "bun run --cwd apps/web format",
    "type-check": "bun run --cwd apps/web type-check",
    "manager-server:test": "cd apps/manager-server && go test ./..."
  }
}
